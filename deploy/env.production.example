# Copy this to .env on the EC2 host (never commit the real file — it's gitignored).
# DATABASE_URL / REDIS_URL / SWEPH_PATH are NOT here — docker-compose.prod.yml sets those
# directly, since they're fixed by the container topology, not secrets.

# Bluesky credentials — a dedicated app password, never the account's primary password.
ASE_HANDLE=ase.tinylil.world
ASE_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
ASE_DID=did:plc:xxxxxxxxxxxxxxxxxxxx

# Real generated secret — do not reuse local dev's "ase" password.
# Generate one with: openssl rand -base64 24
POSTGRES_PASSWORD=xxxx-generate-a-real-secret-xxxx

# Config (see ase_bot_spec_1.md §17.1 for defaults/meaning)
EPHEMERIS_CACHE_TTL_HOURS=2
PHENOMENA_CHECK_INTERVAL_HOURS=2
WORKER_CONCURRENCY=5
DAILY_READINGS_LIMIT=20
HOURLY_READINGS_LIMIT=5

# On by default for this deployment.
WHIMSY_ENABLED=true
